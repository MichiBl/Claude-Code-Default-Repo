# CI-Vorlage für Python-Projekte.
# Aktivieren: Datei nach ci.yml umbenennen und EINEN der beiden Jobs behalten:
#   * "uv"  — für Projekte mit pyproject.toml + uv.lock (empfohlen)
#   * "pip" — für Projekte mit requirements.txt
# Python-Version und Quell-/Testpfade an das Projekt anpassen.

name: CI

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

# Least privilege: der Workflow liest nur den Code.
permissions:
  contents: read

jobs:
  uv:
    name: lint • typecheck • test (uv)
    runs-on: ubuntu-latest
    # Schutz gegen hängende Runner.
    timeout-minutes: 15
    steps:
      - name: Checkout
        # actions/checkout v7.0.1
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1

      - name: Set up Python
        # actions/setup-python v6.3.0
        uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1
        with:
          python-version: "3.12"

      - name: Install uv
        # astral-sh/setup-uv v4.2.0
        uses: astral-sh/setup-uv@38f3f104447c67c051c4a08e39b64a148898af3a
        with:
          enable-cache: true

      - name: Verify lockfile is in sync with pyproject.toml
        run: uv lock --check

      - name: Install dependencies from lockfile
        run: uv sync --locked --extra dev

      - name: Ruff lint
        run: uv run ruff check .

      - name: Ruff format check
        run: uv run ruff format --check .

      - name: Audit dependencies for known CVEs
        # Hartes Gate. Setzt voraus, dass pip-audit als Dev-Dependency im
        # Projekt steht (`[dependency-groups] dev` bzw. `[project.optional-
        # dependencies] dev`) — `uv run` installiert nichts nach, der Step
        # scheitert sonst mit "command not found" statt mit einem Finding.
        run: uv run pip-audit --strict

      - name: Tests (pytest)
        run: uv run pytest -q

  pip:
    name: lint • typecheck • test (pip)
    runs-on: ubuntu-latest
    # Schutz gegen hängende Runner.
    timeout-minutes: 15
    steps:
      - name: Checkout
        # actions/checkout v7.0.1
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1

      - name: Set up Python
        # actions/setup-python v6.3.0
        uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Dependency audit (soft / non-blocking)
        continue-on-error: true
        run: |
          pip install pip-audit
          pip-audit --strict || echo "pip-audit meldete Findings (soft gate)."

      - name: Lint (ruff)
        run: ruff check src tests

      - name: Typecheck (mypy)
        run: mypy src

      - name: Tests (pytest)
        run: pytest
