# CI-Vorlage für Node-/TypeScript-Projekte (Vite, React, …).
# Aktivieren: Datei nach ci.yml umbenennen und die Schritte an das Projekt
# anpassen (Test-Runner, Typecheck-Variante, Node-Version).

name: CI

# Läuft auf jedem PR gegen main (das eigentliche Gate) und auf Pushes nach
# main (damit ein README-Badge den Trunk-Zustand widerspiegelt).
on:
  pull_request:
    branches: [main]
  push:
    branches: [main]

# Überholte Läufe auf demselben Ref abbrechen — spart CI-Minuten.
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

# Least privilege: der Workflow liest nur den Code.
permissions:
  contents: read

jobs:
  lint-test-build:
    name: Lint • Typecheck • Test • Build
    runs-on: ubuntu-latest
    # Schutz gegen hängende Runner (Watch-Mode, eingefrorene Tests).
    timeout-minutes: 15
    steps:
      - name: Checkout
        # actions/checkout v7.0.1
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1

      - name: Setup Node.js
        # actions/setup-node v7.0.0
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020
        with:
          node-version: 20
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Verify npm package signatures
        # Meldet Pakete, deren Registry-Signatur fehlt oder ungültig ist —
        # ein Hinweis auf missbrauchte Maintainer-Tokens. Soft-fail, weil
        # npm-Provenance noch nicht universell ist; Warnungen bei Rot prüfen.
        run: npm audit signatures
        continue-on-error: true

      - name: Audit dependencies for known CVEs
        # Hartes Gate — Gegenstück zu `pip-audit --strict` in der Python-Vorlage.
        # --omit=dev, weil transitive devDependency-Advisories ohne verfügbaren
        # Fix der Hauptgrund sind, warum `npm audit` als Gate abgeschaltet wird;
        # ausgeliefert werden die Production-Deps. Schwelle "high": moderate
        # Findings sind zu häufig, um einen Merge zu blockieren.
        run: npm audit --audit-level=high --omit=dev

      - name: Lint
        run: npm run lint

      - name: Typecheck
        # `tsc -b` folgt Project References (die ein bloßes `tsc --noEmit`
        # bei `files: []`-Root-Configs ignoriert); --noEmit verhindert Output.
        run: npx tsc -b --noEmit

      - name: Test
        run: npm test

      - name: Build
        run: npm run build
